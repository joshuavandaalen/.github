{
  "servers": {
    "microsoftdocs/mcp": {
      "repo": "https://github.com/microsoftdocs/mcp",
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "Playwright MCP": {
      "repo": "https://github.com/microsoft/playwright-mcp",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "type": "stdio"
    },
