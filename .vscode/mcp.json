    "Azure Foundry MCP Server": {
      "repo": "https://github.com/azure-ai-foundry/mcp-foundry",
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--prerelease=allow",
        "--from",
        "git+https://github.com/azure-ai-foundry/mcp-foundry.git",
        "run-azure-ai-foundry-mcp"
      ]
    },
    "M365AgentsToolkit Server": {
      "repo": "https://github.com/OfficeDev/microsoft-365-agents-toolkit",
      "command": "npx",
      "args": [
        "-y",
        "@microsoft/m365agentstoolkit-mcp@latest",
        "server",
        "start"
      ],
      "type": "stdio"
    },
